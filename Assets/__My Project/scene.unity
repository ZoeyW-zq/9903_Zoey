  m_Script: {fileID: 11500000, guid: 80c3b1316db4a3e48aa83df2c8f3f9b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssistantController
  animator: {fileID: 2111649311}
  audioSource: {fileID: 0}
  subtitleText: {fileID: 163793495}
  gameStateController: {fileID: 1681669335}
  officeIntroLines:
  - text: ' You are today''s new sleep organizer, right? I am your assistant.'
    audioClip: {fileID: 0}
    fallbackDuration: 3
    keepVisibleAfterLine: 0
  - text: ' Now place your hand on the crystal ball. We are ready to enter their
      subconscious.'
    audioClip: {fileID: 0}
    fallbackDuration: 3
    keepVisibleAfterLine: 1
  hippocampusIntroLines:
  - text: We have arrived in the client's hippocampus.
    audioClip: {fileID: 0}
    fallbackDuration: 2
    keepVisibleAfterLine: 0
  - text: This object represents one of their memories from today's experience.
    audioClip: {fileID: 0}
    fallbackDuration: 3
    keepVisibleAfterLine: 1
  memoryRevealedLines:
  - text: Oh, so this memory represents...  Maybe we should put it into the shor
      term memory
    audioClip: {fileID: 0}
    fallbackDuration: 2
    keepVisibleAfterLine: 1
  memoryPlacementHintLines: []
  nightmareWarningLines:
  - text: It seems the client is entering a nightmare...
    audioClip: {fileID: 0}
    fallbackDuration: 2
    keepVisibleAfterLine: 1
  swallowTransitionLines:
  - text: Hold on. We are being pulled into a deeper layer.
    audioClip: {fileID: 0}
    fallbackDuration: 2
    keepVisibleAfterLine: 1
  mirrorChamberIntroLines:
  - text: These mirrors seem to reflect something from outside.
    audioClip: {fileID: 0}
    fallbackDuration: 0
    keepVisibleAfterLine: 1
