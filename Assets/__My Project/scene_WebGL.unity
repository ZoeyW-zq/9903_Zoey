  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3c8b719f9d5d4d94b6d8e2f3aa4d9c1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoryDialogueController
  startButtonRoot: {fileID: 1957189439}
  dialogueRoot: {fileID: 148581801}
  round1ChoicesRoot: {fileID: 1071902079}
  dialogueText: {fileID: 827698408}
  dialogueAudioSource: {fileID: 1437690448}
  webGLEchoAudio: {fileID: 0}
  durationWithoutAudio: 3
  openingLoopInterval: 1
  openingText: Several times when I gathered the courage to ask for help, it didn't
    end well. I need to make myself stronger so I can stop asking anyone for help.
  openingClip: {fileID: 8300000, guid: bf5b40842df4ea644817c11edae369f8, type: 3}
  round1Choices:
  - goesToRound2: 1
    nextBranchIndex: 0
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 1
    nextBranchIndex: 1
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 0
    nextBranchIndex: 0
    responseText: Right. Only if I carry it all alone will I avoid being rejected
      again. No matter how tired I get, I can't speak up.
    responseClip: {fileID: 8300000, guid: 736982c0d7370e04d9a36c80c70845a2, type: 3}
  round2Branches:
  - choicesRoot: {fileID: 803598511}
    promptText: But if I ask for help next time and still get rejected?
    promptClip: {fileID: 8300000, guid: ecd41431e851b7d4dbfa6cab3196952c, type: 3}
    choices:
    - responseText: I can try speaking up. How others respond shouldn't decide whether
        I am allowed to need help.
      responseClip: {fileID: 8300000, guid: eb22a20bb8b76264bafb8af9bb6eb16b, type: 3}
      completesMemory: 1
    - responseText: Right. Only if I carry it all alone will I avoid being rejected
        again. No matter how tired I get, I can't speak up.
      responseClip: {fileID: 8300000, guid: 736982c0d7370e04d9a36c80c70845a2, type: 3}
      completesMemory: 0
  - choicesRoot: {fileID: 1631515657}
    promptText: But needing help from others still makes me feel unreliable.
    promptClip: {fileID: 8300000, guid: aa4adf830403f9f4ebecd6fdc46843c4, type: 3}
    choices:
    - responseText: I can try speaking up. How others respond shouldn't decide whether
        I am allowed to need help.
      responseClip: {fileID: 8300000, guid: eb22a20bb8b76264bafb8af9bb6eb16b, type: 3}
      completesMemory: 1
    - responseText: Right. Only if I carry it all alone will I avoid being rejected
        again. No matter how tired I get, I can't speak up.
      responseClip: {fileID: 8300000, guid: 736982c0d7370e04d9a36c80c70845a2, type: 3}
      completesMemory: 0
  completionSfxClip: {fileID: 8300000, guid: b96137b194006b649923ab5a64a6b35f, type: 3}
