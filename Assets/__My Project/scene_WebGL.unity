  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Do Not Rewrite\nA memory may be understood differently, but it must not
    be erased, fabricated, or altered without consent.\n\nMake Room for Complexity\nA
    memory may contain pain, warmth, regret, and meaning at the same time.\nNo feeling
    needs to be denied for another feeling to exist.\n\nGuide Attention, Do Not Control
    It\nPain deserves to be acknowledged, but it does not deserve to occupy everything.\nHelp
    the client decide what deserves their attention now.\n\n\nWe do not organize
    a client\u2019s past.\nWe help them choose how much space the past will take
    in the present."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
