--- !u!114 &1246805545
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1246805543}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3c8b719f9d5d4d94b6d8e2f3aa4d9c1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoryDialogueController
  startButtonRoot: {fileID: 1667276111}
  dialogueRoot: {fileID: 1269585595}
  round1ChoicesRoot: {fileID: 376543596}
  dialogueText: {fileID: 328240652}
  dialogueAudioSource: {fileID: 2111465143}
  webGLEchoAudio: {fileID: 0}
  durationWithoutAudio: 3
  openingLoopInterval: 1
  openingText: Unfinished things keep chasing me like an alarm bell. I'm exhausted,
    but I still can't stop.
  openingClip: {fileID: 8300000, guid: 91e365f50f8d57b45a1c3179ad6d7ab7, type: 3}
  round1Choices:
  - goesToRound2: 1
    nextBranchIndex: 0
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 1
    nextBranchIndex: 1
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 0
    nextBranchIndex: 0
    responseText: But the work never ends... does that mean I can never stop?
    responseClip: {fileID: 8300000, guid: 81953babad19a29428c1cc9869c0145f, type: 3}
  round2Branches:
  - choicesRoot: {fileID: 750629101}
    promptText: But if I rest, am I being irresponsible to myself and to others?
    promptClip: {fileID: 8300000, guid: 24368a11211e6224f89bd7238dfa98bd, type: 3}
    choices:
    - responseText: Rest is not avoiding responsibility. I can stop to take care
        of myself, and then decide what to do next.
      responseClip: {fileID: 8300000, guid: afa7814d7ba73ec48a22ce80f7ed00c7, type: 3}
      completesMemory: 1
    - responseText: But the work never ends... does that mean I can never stop?
      responseClip: {fileID: 8300000, guid: 81953babad19a29428c1cc9869c0145f, type: 3}
      completesMemory: 0
  - choicesRoot: {fileID: 2034981382}
    promptText: But every time I stop, I feel guilty, like I've done something wrong.
    promptClip: {fileID: 8300000, guid: b6c5e139c30c9e14c83f89b826da31a1, type: 3}
    choices:
    - responseText: Rest is not avoiding responsibility. I can stop to take care
        of myself, and then decide what to do next.
      responseClip: {fileID: 8300000, guid: afa7814d7ba73ec48a22ce80f7ed00c7, type: 3}
      completesMemory: 1
    - responseText: But the work never ends... does that mean I can never stop?
      responseClip: {fileID: 8300000, guid: 81953babad19a29428c1cc9869c0145f, type: 3}
      completesMemory: 0
  completionSfxClip: {fileID: 8300000, guid: 56269d840ac40b54e82dd51705d40db3, type: 3}
