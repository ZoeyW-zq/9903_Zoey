  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OfficeDialogueController
  assistantController: {fileID: 1209064767}
  gameStateController: {fileID: 1681669335}
  choiceCanvas: {fileID: 1472470781}
  jobExplanationButton: {fileID: 1659688365}
  exploreOfficeButton: {fileID: 881631556}
  startWorkButton: {fileID: 110311890}
  greetingLines:
  - text: Helllo, You must be the new .......... do you wanna.......?
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 1
    keepVisibleAfterLine: 1
  jobExplanationLines:
  - text: 'oh I thought you are already familiar with this job since you passed the
      exam.... '
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 2
    keepVisibleAfterLine: 0
  - text: Anyway, your responsibility is......
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 2
    keepVisibleAfterLine: 0
  - text: There is a onboarding book in th room, it'll help you alittle bit. are
      you ready to start woeking now?
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 2
    keepVisibleAfterLine: 1
  explorationDepartureLines:
  - text: okay! you can start working anytime when you are ready
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 3
    keepVisibleAfterLine: 0
  explorationReturnLines:
  - text: ' are you ready to start woeking now?'
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 1
    keepVisibleAfterLine: 1
  startWorkLines:
  - text: great! see the person on the screen? he is our first client and he is already
      fall asleep
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 2
    keepVisibleAfterLine: 0
  - text: He is stressful recently, we should help him focus more on positive thing.
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 2
    keepVisibleAfterLine: 0
  crystalBallInstructionLines:
  - text: when you are ready, put your hands on the crystal ball, we are entering
      his deep mind!
    audioClip: {fileID: 0}
    fallbackSubtitleDuration: 1
    keepVisibleAfterLine: 1
