  round1ChoicesRoot: {fileID: 893903427}
  dialogueText: {fileID: 2128507157}
  dialogueAudioSource: {fileID: 1774709947}
  webGLEchoAudio: {fileID: 0}
  durationWithoutAudio: 3
  openingLoopInterval: 1
  openingText: Maybe I just don't have the ability at all... I deserve to be criticized
    in front of everyone.
  openingClip: {fileID: 8300000, guid: 066dce1805187d4428ea880ce43afd00, type: 3}
  round1Choices:
  - goesToRound2: 1
    nextBranchIndex: 0
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 1
    nextBranchIndex: 1
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 0
    nextBranchIndex: 0
    responseText: Right, I have to make sure everything is perfect. If I make another
      mistake, they'll find out I'm not reliable at all.
    responseClip: {fileID: 8300000, guid: 34dab0f9b22325743ab6b22246d7a002, type: 3}
  round2Branches:
  - choicesRoot: {fileID: 1286350051}
    promptText: But now every time I submit a file, I think of that red pen.
    promptClip: {fileID: 8300000, guid: f33c4e18a5f16ed45b1e363b393182b2, type: 3}
    choices:
    - responseText: I can check carefully and fix mistakes, but I don't need to rely
        on never making mistakes to prove my ability.
      responseClip: {fileID: 8300000, guid: f0b2e59199be2b94897b008f0b1a0e8e, type: 3}
      completesMemory: 1
    - responseText: Right, I have to make sure everything is perfect. If I make another
        mistake, they'll find out I'm not reliable at all.
      responseClip: {fileID: 8300000, guid: 34dab0f9b22325743ab6b22246d7a002, type: 3}
      completesMemory: 0
  - choicesRoot: {fileID: 680822296}
    promptText: But what if the next mistake really does cause consequences?
    promptClip: {fileID: 8300000, guid: 75f5bca3146f39543a8f8a069d4d6ddb, type: 3}
    choices:
    - responseText: I can check carefully and fix mistakes, but I don't need to rely
        on never making mistakes to prove my ability.
      responseClip: {fileID: 8300000, guid: f0b2e59199be2b94897b008f0b1a0e8e, type: 3}
      completesMemory: 1
    - responseText: Right, I have to make sure everything is perfect. If I make another
        mistake, they'll find out I'm not reliable at all.
      responseClip: {fileID: 8300000, guid: 34dab0f9b22325743ab6b22246d7a002, type: 3}
      completesMemory: 0
