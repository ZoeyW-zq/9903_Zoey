--- !u!114 &1994542148
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1994542146}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3c8b719f9d5d4d94b6d8e2f3aa4d9c1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoryDialogueController
  startButtonRoot: {fileID: 1007150330}
  dialogueRoot: {fileID: 446638289}
  round1ChoicesRoot: {fileID: 1760182870}
  dialogueText: {fileID: 1799957483}
  dialogueAudioSource: {fileID: 864398237}
  webGLEchoAudio: {fileID: 0}
  durationWithoutAudio: 3
  openingLoopInterval: 1
  openingText: No one remembers second place... maybe only first place would make
    my parents happy.
  openingClip: {fileID: 8300000, guid: 8c745fbbc78889d458ed1977c6a2e12c, type: 3}
  round1Choices:
  - goesToRound2: 1
    nextBranchIndex: 0
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 1
    nextBranchIndex: 1
    responseText: 
    responseClip: {fileID: 0}
  - goesToRound2: 0
    nextBranchIndex: 0
    responseText: Right... if it's not first place yet, I'm still not good enough.
      I can't stop.
    responseClip: {fileID: 8300000, guid: bf7c3b094243a4d4dbeb23a4cd9242e0, type: 3}
  round2Branches:
  - choicesRoot: {fileID: 2068288228}
    promptText: But if I'm satisfied with second place, does that mean I'm not ambitious
      enough?
    promptClip: {fileID: 8300000, guid: 3753f634f0cbf504dbb9bf52e0d952e4, type: 3}
    choices:
    - responseText: I can keep growing, but I don't have to wait until I'm first
        place before I allow myself to recognize what I've already done.
      responseClip: {fileID: 8300000, guid: 214ba20ecd1664548bb4f3cf45527294, type: 3}
      completesMemory: 1
    - responseText: Right... if it's not first place yet, I'm still not good enough.
        I can't stop.
      responseClip: {fileID: 8300000, guid: bf7c3b094243a4d4dbeb23a4cd9242e0, type: 3}
      completesMemory: 0
  - choicesRoot: {fileID: 901071820}
    promptText: But they always think I'm still not good enough. It's hard for me
      to believe second place really has value.
    promptClip: {fileID: 8300000, guid: 414493ebca713fb4d82131c5dd9a192a, type: 3}
    choices:
    - responseText: I can keep growing, but I don't have to wait until I'm first
        place before I allow myself to recognize what I've already done.
      responseClip: {fileID: 8300000, guid: 214ba20ecd1664548bb4f3cf45527294, type: 3}
      completesMemory: 1
    - responseText: Right... if it's not first place yet, I'm still not good enough.
        I can't stop.
      responseClip: {fileID: 8300000, guid: bf7c3b094243a4d4dbeb23a4cd9242e0, type: 3}
      completesMemory: 0
